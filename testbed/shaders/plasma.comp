#version 450

// Writes an animated plasma into a storage image each frame. p.data = (time, width, height).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D img;
layout(set = 0, binding = 1) uniform P
{
    vec4 data;
} p;

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    vec2 res = vec2(p.data.y, p.data.z);
    if (pix.x >= int(res.x) || pix.y >= int(res.y))
        return;

    vec2 uv = vec2(pix) / res;
    float t = p.data.x;
    float v = sin(uv.x * 10.0 + t)
            + sin(uv.y * 10.0 + t * 1.3)
            + sin((uv.x + uv.y) * 10.0 + t * 0.7)
            + sin(length(uv - 0.5) * 20.0 - t * 2.0);
    v *= 0.25;
    vec3 col = 0.5 + 0.5 * cos(6.2831 * (vec3(0.0, 0.33, 0.67) + v));
    imageStore(img, pix, vec4(col, 1.0));
}
